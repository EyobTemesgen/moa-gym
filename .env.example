# ==============================================================================
# MoA Staff Wellness & Gym Management System — Environment Configuration
# ==============================================================================
# Copy this file to ".env" in the same folder and set strong secrets.
# Never commit the .env file to version control.

# Deployment environment tier: dev | qa | stage | prod
APP_ENV=prod
TZ=Africa/Addis_Ababa

# ── Database Configuration ───────────────────────────────────────────────────
POSTGRES_USER=moa_gym_user
# Strong database password (alphanumeric, min 24 chars): openssl rand -hex 24
POSTGRES_PASSWORD=moa_gym_secure_pass_2026
POSTGRES_DB=moa_gym_db

# ── JWT Security & Token Expiry ──────────────────────────────────────────────
# Random 64-character hex secret for signing user tokens: openssl rand -hex 32
JWT_SECRET=moa_gym_super_secure_jwt_secret_key_2026_at_least_32_characters_long
JWT_EXPIRATION=8h

# ── Reverse Proxy & Network ──────────────────────────────────────────────────
# 1 when running behind Nginx so rate limiters and audit logs see the real client IP
TRUST_PROXY=1

# Local development port override (used by docker-compose.local.yml)
LOCAL_PORT=3005
