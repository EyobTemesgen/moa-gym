generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GYM_ATTENDANT
  STAFF_MEMBER
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LockerStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model HrEmployeeRoster {
  employeeId       String           @id
  fullName         String
  department       String
  phone            String
  email            String?
  photoUrl         String?
  employmentStatus EmploymentStatus @default(ACTIVE)
  syncedAt         DateTime         @updatedAt
  userAccount      User?
  gymRegistrations GymRegistration[]
}

model User {
  id                    String           @id @default(uuid())
  employeeId            String           @unique
  hrRecord              HrEmployeeRoster @relation(fields: [employeeId], references: [employeeId])
  passwordHash          String
  role                  Role             @default(STAFF_MEMBER)
  memberType            String           @default("INTERNAL")
  waiverSigned          Boolean          @default(false)
  waiverSignedAt        DateTime?
  parqResponses         Json?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  attendanceLogs        Attendance[]
  classBookings         ClassBooking[]
}

model Attendance {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  checkInTime   DateTime  @default(now())
  checkOutTime  DateTime?
  lockerNumber  String?
  checkedInById String?
  autoClosed    Boolean   @default(false)

  @@index([checkOutTime])
  @@index([userId])
}

model Locker {
  id             String       @id @default(uuid())
  lockerNumber   String       @unique
  status         LockerStatus @default(AVAILABLE)
  assignedUserId String?
}

model WellnessClass {
  id             String         @id @default(uuid())
  title          String
  instructorName String
  scheduledDate  DateTime
  startTime      String
  endTime        String
  capacity       Int
  bookings       ClassBooking[]
}

model ClassBooking {
  id        String        @id @default(uuid())
  classId   String
  class     WellnessClass @relation(fields: [classId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  attended  Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@unique([classId, userId])
}

model EquipmentIssue {
  id            String      @id @default(uuid())
  equipmentName String
  description   String
  status        IssueStatus @default(OPEN)
  reportedAt    DateTime    @default(now())
  resolvedAt    DateTime?
}

model SystemConfig {
  id          Int    @id @default(1)
  maxCapacity Int    @default(40)
  waiverText  String
}

model GymRegistration {
  id                 String            @id @default(uuid())
  regNumber          Int               @unique @default(autoincrement()) // ተ.ቁ (1, 2, 3...)
  employeeId         String
  fullName           String            // ስም ዝርዝር (Full Name)
  department         String            // የስራ ክፍል (Directorate / Work Unit)
  phone              String?           // ስልክ ቁጥር
  email              String?
  gender             String?           // MALE / FEMALE
  shiftPreference    String?           // MORNING / LUNCH / EVENING / ANY
  memberType         String            @default("INTERNAL") // INTERNAL (MoA Staff) / EXTERNAL (Community / Partner)
  organization       String?           // Organization or Institution for External members
  daysPerWeek        Int               @default(3) // 2, 3, 4, 5, 6 days per week
  workoutDays        String?           // Comma-separated list of days (e.g. "MON,WED,FRI")
  monthlyFee         Float             @default(0) // Calculated ETB fee
  paymentMethod      String?           // PAYROLL_DEDUCTION, TELEBIRR, CBE_BIRR, CASH_DESK
  fitnessGoal        String?           // General Fitness, Muscle Building, Cardio/Aerobics, Posture Relief
  lockerNumber       String?           // Assigned locker number e.g. L-04
  registeredAt       DateTime          @default(now())
  registeredBy       String?           // Attendant or Admin name/ID
  registrationSource String            @default("FRONT_DESK") // FRONT_DESK, SELF_SERVICE, PAPER_BATCH
  signatureConfirmed Boolean           @default(true) // ፊርማ ማረጋገጫ
  signatureData      String?           // Drawn signature data URL or note
  status             String            @default("ACTIVE") // ACTIVE, SUSPENDED, CANCELLED
  remarks            String?           // Any specific remark or medical note

  hrRecord           HrEmployeeRoster? @relation(fields: [employeeId], references: [employeeId], onDelete: SetNull)

  @@index([employeeId])
  @@index([department])
  @@index([status])
  @@index([regNumber])
  @@index([memberType])
}
