{
  "name": "moa-gym",
  "version": "1.0.0",
  "description": "MoA Staff Gym & Wellness Management System (Ministry of Agriculture, Ethiopia)",
  "private": true,
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "docker:local": "docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build",
    "docker:local:down": "docker compose -f docker-compose.yml -f docker-compose.local.yml down",
    "docker:local:logs": "docker compose -f docker-compose.yml -f docker-compose.local.yml logs -f",
    "docker:prod": "docker compose up -d --build",
    "docker:prod:down": "docker compose down",
    "docker:prod:logs": "docker compose logs -f"
  },
  "keywords": [
    "ethiopia",
    "moa",
    "gym-management",
    "internal-wellness"
  ],
  "author": "Ministry of Agriculture - ICT Directorate",
  "license": "UNLICENSED"
}
